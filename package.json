{
  "name": "uptown-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The UpTown website: a static site that reads every figure from the contracts and sends the nine actions (F8b).",
  "scripts": {
    "addresses": "node scripts/addresses.mjs",
    "predev": "node scripts/addresses.mjs",
    "dev": "vite",
    "prebuild": "node scripts/check-chain.mjs && node scripts/addresses.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check:copy": "node scripts/check-copy.mjs",
    "test": "node scripts/test-addresses.mjs && node scripts/test-hosting.mjs && node scripts/test.mjs"
  },
  "dependencies": {
    "preact": "11.0.1",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
